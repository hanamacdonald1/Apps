# Copy this file to ".env" to change settings. Never commit ".env".
# None of these are secrets - Ollama runs on your own computer.

# Port the chat page uses: http://localhost:3000
PORT=3000

# Where Ollama is listening (its default address)
OLLAMA_URL=http://localhost:11434

# Model used the first time you open the app (you can change it in the app too)
DEFAULT_MODEL=llama3.2
